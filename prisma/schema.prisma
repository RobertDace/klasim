datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String       @id @default(cuid())
  name        String
  email       String       @unique
  password    String       // Hashed password
  avatarUrl   String?
  tournaments Tournament[]
  sessions    Session[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
  createdAt    DateTime @default(now())
}

model Game {
  id          String       @id @default(cuid())
  name        String       // Contoh: "Mobile Legends", "Valorant"
  slug        String       @unique // Contoh: "mlbb", "valorant"
  tournaments Tournament[]
}

model Tournament {
  id        String   @id @default(cuid())
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id])
  userId    String?  // Relasi opsional ke pemilik/kreator turnamen
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String   // Contoh: "MPL ID Season 14"
  slug      String   @unique // Contoh: "mpl-id-s14"
  format    String   @default("MPL_BO3") // Identifier logika kalkulasi
  teams     Team[]
  matches   Match[]
  createdAt DateTime @default(now())
}

model Team {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name         String     // Contoh: "RRQ Hoshi"
  code         String     // Contoh: "RRQ"
  logoUrl      String?
  
  homeMatches  Match[]    @relation("HomeTeam")
  awayMatches  Match[]    @relation("AwayTeam")
}

model Match {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  
  week         Int
  homeTeamId   String
  awayTeamId   String
  homeTeam     Team       @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam     Team       @relation("AwayTeam", fields: [awayTeamId], references: [id])
  
  homeScore    Int        @default(0)
  awayScore    Int        @default(0)
  isCompleted  Boolean    @default(false)
  
  createdAt    DateTime   @default(now())
}